# Set exactly one secret source before first start. SECRET_KEY takes precedence if both are set.
TZ=UTC
DEFAULT_LANGUAGE=en
SECRET_KEY=
# SECRET_KEY_FILE=/run/secrets/ovumcy_secret_key
POSTGRES_DB=ovumcy
POSTGRES_USER=ovumcy
POSTGRES_PASSWORD=replace_with_a_long_random_password
# The bundled compose file mounts an ovumcy_fence volume for the calendar-feed
# restore fence and points CALENDAR_FEED_FENCE_PATH at it; nothing to set here.
# One rule makes it work: never include that volume in a backup and never restore
# it beside the database. A fence restored together with the database agrees with
# it, and agreement is what the app reads as "nothing was rolled back".
COOKIE_SECURE=false
# Optional OIDC sign-in / SSO.
# Requires HTTPS plus COOKIE_SECURE=true when exposed through a public HTTPS entrypoint.
# OIDC_ISSUER_URL=https://id.example.com
# OIDC_CLIENT_ID=ovumcy
# OIDC_CLIENT_SECRET=replace_with_a_client_secret
# OIDC_CLIENT_SECRET_FILE=/run/secrets/ovumcy_oidc_client_secret
# OIDC_REDIRECT_URL=https://ovumcy.example.com/auth/oidc/callback
# OIDC_CA_FILE=/run/certs/oidc-provider-ca.pem
# OIDC_LOGIN_MODE=hybrid
# OIDC_RESPONSE_MODE=form_post
# OIDC_AUTO_PROVISION=false
# OIDC_AUTO_PROVISION_ALLOWED_DOMAINS=
# OIDC_LOGOUT_MODE=local
# OIDC_POST_LOGOUT_REDIRECT_URL=https://ovumcy.example.com/login
RATE_LIMIT_LOGIN_MAX=8
RATE_LIMIT_LOGIN_WINDOW=15m
RATE_LIMIT_FORGOT_PASSWORD_MAX=8
RATE_LIMIT_FORGOT_PASSWORD_WINDOW=1h
RATE_LIMIT_TOTP_CHALLENGE_MAX=8
RATE_LIMIT_TOTP_CHALLENGE_WINDOW=15m
RATE_LIMIT_PASSWORD_RESET_REDEEM_MAX=8
RATE_LIMIT_PASSWORD_RESET_REDEEM_WINDOW=15m
RATE_LIMIT_API_MAX=300
RATE_LIMIT_API_WINDOW=1m
RATE_LIMIT_REGISTER_MAX=8
RATE_LIMIT_REGISTER_WINDOW=15m
RATE_LIMIT_LOGOUT_MAX=60
RATE_LIMIT_LOGOUT_WINDOW=15m
RATE_LIMIT_LOGOUT_ACCOUNT_MAX=20
RATE_LIMIT_LOGOUT_ACCOUNT_WINDOW=15m
RATE_LIMIT_CALENDAR_FEED_MAX=20
RATE_LIMIT_CALENDAR_FEED_WINDOW=1m
RATE_LIMIT_CALENDAR_MAX=300
RATE_LIMIT_CALENDAR_WINDOW=1m
# open or closed. Public instances should usually close open registration.
REGISTRATION_MODE=open
# Strict-Transport-Security. Defaults to COOKIE_SECURE when unset.
HSTS_ENABLED=
OIDC_ENABLED=false
AUDIT_LOG_ENABLED=false
# Built-in daily reminder scheduler (outbound webhook calls once per day, per owner).
# REMINDER_SCHEDULER_ENABLED=false
# REMINDER_SCHEDULER_HOUR=9
# Unset: on when REGISTRATION_MODE=open, off when closed. Set true on any closed multi-owner instance.
# WEBHOOK_BLOCK_PRIVATE_ADDRESSES=
# Strict boolean; leave it unset. The fence volume above is the supported setup.
# CALENDAR_FEED_FENCE_OPTOUT=true
# This stack sets TRUST_PROXY_ENABLED=false itself; the proxy-header settings apply
# only to the reverse-proxy stacks.
# PROXY_HEADER=X-Forwarded-For
# TRUSTED_PROXIES=127.0.0.1,::1
# Image to run; leave unset to use the release the compose file pins.
# OVUMCY_IMAGE=
